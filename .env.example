APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

DATABASE_URL=
REDIS_URL=

# Comma-separated allowed frontend origins for CORS. Defaults to the local
# Vite dev server if unset — only needed for a deployed frontend origin
# (e.g. https://your-frontend.onrender.com).
CORS_ORIGINS=

AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Frontend (Vite exposes only VITE_-prefixed vars to client code)
VITE_API_BASE_URL=http://localhost:8000
